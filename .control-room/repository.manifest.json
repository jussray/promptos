{
  "schemaVersion": "1.0",
  "projectId": "promptos",
  "repository": {
    "provider": "github",
    "identifier": "jussray/promptos",
    "defaultBranch": "main"
  },
  "verification": {
    "requiredSignals": [
      {
        "id": "promptos-control-room-tests",
        "name": "Verify PromptOS control room tests",
        "required": true
      }
    ],
    "testCatalog": [
      {
        "id": "assembly-determinism",
        "name": "PromptOS index source authority",
        "kind": "build",
        "signalId": "promptos-control-room-tests",
        "required": true,
        "command": "node scripts/verify-control-room-tests.mjs",
        "workflow": ".github/workflows/control-room-tests.yml"
      },
      {
        "id": "prompt-module-syntax",
        "name": "Prompt module JavaScript syntax",
        "kind": "contract",
        "signalId": "promptos-control-room-tests",
        "required": true,
        "command": "node scripts/verify-control-room-tests.mjs",
        "workflow": ".github/workflows/control-room-tests.yml"
      },
      {
        "id": "zapier-sdk-typecheck",
        "name": "Isolated Zapier SDK TypeScript",
        "kind": "typecheck",
        "signalId": "promptos-control-room-tests",
        "required": true,
        "command": "npm --prefix tools/zapier run typecheck",
        "workflow": ".github/workflows/control-room-tests.yml"
      },
      {
        "id": "rendered-browser-proof",
        "name": "PromptOS rendered desktop and mobile proof",
        "kind": "e2e",
        "signalId": "promptos-control-room-tests",
        "required": true,
        "command": "node e2e/rendered-proof.mjs",
        "workflow": ".github/workflows/control-room-tests.yml"
      }
    ]
  },
  "capabilities": [
    {
      "id": "deterministic-promptos-assembly",
      "description": "Verifies the explicit index script-source graph against the canonical checked-in JavaScript modules without rebuilding or committing index.html.",
      "status": "active",
      "evidencePaths": [
        "index.html",
        "parts/p05-new-prompts.js",
        "parts/p06-gap-prompts.js",
        "parts/p07-ship-ultrathink-skills.js",
        "parts/p08-cont-redteam.js",
        "parts/p09-cont-design.js",
        "parts/p10-cont-ops-growth.js",
        ".github/workflows/assemble.yml",
        "scripts/verify-control-room-tests.mjs",
        ".github/workflows/control-room-tests.yml"
      ],
      "requiredSignals": ["promptos-control-room-tests"],
      "usageAssertions": [
        {
          "id": "catalog-workflow-runs-non-mutating-verifier",
          "path": ".github/workflows/control-room-tests.yml",
          "marker": "node scripts/verify-control-room-tests.mjs",
          "description": "The exact-head Control Room workflow verifies source authority without repository mutation."
        },
        {
          "id": "legacy-assembler-is-read-only",
          "path": ".github/workflows/assemble.yml",
          "marker": "contents: read",
          "description": "The historical assembly entrypoint is retained only as a read-only source-authority verifier."
        },
        {
          "id": "index-loads-canonical-redteam-module",
          "path": "index.html",
          "marker": "./parts/p08-cont-redteam.js",
          "description": "The runtime index loads the canonical p08 JavaScript module directly."
        }
      ]
    },
    {
      "id": "rendered-promptos-browser-proof",
      "description": "Exercises guest boot, canonical prompt-module rendering, search, modal open, and theme interaction at desktop and mobile viewports.",
      "status": "active",
      "evidencePaths": [
        "index.html",
        "e2e/rendered-proof.mjs",
        ".github/workflows/control-room-tests.yml"
      ],
      "requiredSignals": ["promptos-control-room-tests"],
      "usageAssertions": [
        {
          "id": "control-room-runs-rendered-proof",
          "path": ".github/workflows/control-room-tests.yml",
          "marker": "node e2e/rendered-proof.mjs",
          "description": "The exact-head Control Room workflow runs the browser proof."
        },
        {
          "id": "rendered-proof-exercises-p08",
          "path": "e2e/rendered-proof.mjs",
          "marker": "Jailbreak Pack Review",
          "description": "The browser proof confirms a prompt supplied by the canonical p08 module is rendered and interactive."
        }
      ]
    },
    {
      "id": "isolated-zapier-sdk-tooling",
      "description": "Keeps Zapier SDK bootstrap and typechecking isolated from the static PromptOS runtime and excludes credential material from evidence.",
      "status": "active",
      "evidencePaths": [
        "tools/zapier/package.json",
        "tools/zapier/tsconfig.json",
        "tools/zapier/scripts/sync-lockfile.mjs",
        ".github/workflows/zapier-sdk-tooling.yml",
        ".github/workflows/control-room-tests.yml"
      ],
      "requiredSignals": ["promptos-control-room-tests"],
      "usageAssertions": [
        {
          "id": "catalog-workflow-syncs-canonical-lock",
          "path": ".github/workflows/control-room-tests.yml",
          "marker": "sync-lockfile.mjs",
          "description": "The exact-head control-room workflow materializes the verified lock before installation."
        },
        {
          "id": "catalog-workflow-typechecks-isolated-tooling",
          "path": ".github/workflows/control-room-tests.yml",
          "marker": "npm --prefix tools/zapier run typecheck",
          "description": "The isolated SDK is typechecked without widening PromptOS runtime authority."
        }
      ]
    },
    {
      "id": "public-pages-deploy-identity",
      "description": "Founder-gated, workflow_dispatch-only publication of the exact-head index.html and its canonical parts/*.js to GitHub Pages, with the deployed page stamped with the published commit SHA and proven anonymous, wall-free, and CTA-functional at desktop and mobile viewports before the run is treated as evidence.",
      "status": "founder-gated",
      "evidencePaths": [
        "index.html",
        "parts/auth.js",
        "parts/app.js",
        ".github/workflows/pages-deploy.yml",
        "e2e/public-deploy-proof.mjs",
        "control-room.manifest.json"
      ],
      "requiredSignals": [],
      "usageAssertions": [
        {
          "id": "pages-workflow-is-manual-only",
          "path": ".github/workflows/pages-deploy.yml",
          "marker": "workflow_dispatch:",
          "description": "Publication only ever runs on an explicit human-triggered workflow_dispatch, never on push or pull_request."
        },
        {
          "id": "pages-artifact-excludes-governance-surfaces",
          "path": ".github/workflows/pages-deploy.yml",
          "marker": "Only the public human-facing surface is staged",
          "description": "The staged Pages artifact copies only index.html and its canonical parts/*.js; Chief AI Machine, Founder Control Room, and governance manifests are never copied into the public artifact."
        },
        {
          "id": "public-proof-checks-runtime-identity",
          "path": "e2e/public-deploy-proof.mjs",
          "marker": "promptos-deploy-sha",
          "description": "The public proof fails unless the deployed page's stamped commit SHA equals the exact source SHA that was published."
        }
      ]
    },
    {
      "id": "repo-local-promptos-test-control-room",
      "description": "Catalogs PromptOS source, browser, and tooling gates locally, then exports only sanitized provider-check summaries to Founder Control Room.",
      "status": "active",
      "evidencePaths": [
        "control-room.manifest.json",
        ".control-room/repository.manifest.json",
        "scripts/verify-control-room-tests.mjs",
        "e2e/rendered-proof.mjs",
        ".github/workflows/control-room-tests.yml"
      ],
      "requiredSignals": ["promptos-control-room-tests"],
      "usageAssertions": [
        {
          "id": "local-control-room-denies-private-content",
          "path": "control-room.manifest.json",
          "marker": "\"privateContentAllowed\": false",
          "description": "The local PromptOS control room forbids private content in portfolio evidence."
        },
        {
          "id": "local-control-room-requires-rendered-proof",
          "path": "control-room.manifest.json",
          "marker": "\"id\": \"rendered-browser-proof\"",
          "description": "Rendered behavior remains a required catalog gate rather than an optional screenshot."
        }
      ]
    }
  ],
  "buildAssist": {
    "enabled": true,
    "preferredBuilder": "codex",
    "riskLevel": "medium"
  },
  "privacy": {
    "allowlistedPacketFields": [
      "projectId",
      "repository.provider",
      "repository.identifier",
      "commitSha",
      "branch",
      "manifestHash",
      "generatedAt",
      "runner.provider",
      "runner.runId",
      "runner.detailsUrl",
      "checks.id",
      "checks.name",
      "checks.required",
      "checks.status",
      "checks.detailsUrl",
      "capabilities.id",
      "capabilities.claimedStatus",
      "capabilities.observedStatus",
      "capabilities.evidencePaths",
      "capabilities.usageAssertionIds",
      "capabilities.failedUsageAssertionIds",
      "capabilities.reason"
    ],
    "forbiddenData": [
      "Zapier credentials or profile data",
      "provider API keys or secrets",
      "raw prompts entered by users",
      "private model responses",
      "raw workflow logs containing secrets",
      "usage assertion marker text in runner packets"
    ]
  }
}
