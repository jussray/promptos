{
  "name": "promptos-provider",
  "main": "cloudflare-worker/analytics.js",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": {
    "required": ["OPENAI_API_KEY", "PROMPTOS_AI_OPERATOR_KEY"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
