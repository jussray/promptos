{
  "name": "promptos-library-store-sandbox",
  "main": "cloudflare-worker/library-store.mjs",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": false
  },
  "services": [
    {
      "binding": "PROMPTOS_JUSSPAY",
      "service": "jusspay-promptos-sandbox"
    }
  ],
  "vars": {
    "PROMPTOS_LIBRARY_STORE_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIBRARY_ACCOUNTS",
        "class_name": "PromptLibraryAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "library-v1",
      "new_sqlite_classes": [
        "PromptLibraryAccount"
      ]
    }
  ]
}
